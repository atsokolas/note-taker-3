{
  "manifest_version": 3,
  "name": "Noeis",
  "description": "Save what you read to Noeis, with the passages you mark.",
  "version": "1.4",
  "default_locale": "en",
  "icons": {
    "48": "images/Logo.png",
    "128": "images/Logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://note-taker-3-unrg.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["Readability.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "Readability.js" ],
      "matches": [ "<all_urls>" ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://noeis.io/*",
      "https://www.noeis.io/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://note-taker-3-unrg.onrender.com;"
  }
}
