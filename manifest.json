{
  "manifest_version": 3,
  "name": "Noeis",
  "description": "Save what you read, mark the passages that matter, and see where they meet the views you hold.",
  "version": "1.5",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Noeis"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Save this page to Noeis"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://note-taker-3-unrg.onrender.com/*"],
  "content_scripts": [
    {
      "matches": ["https://noeis.io/*", "https://www.noeis.io/*"],
      "js": ["presence.js"],
      "run_at": "document_idle"
    }
  ]
}
