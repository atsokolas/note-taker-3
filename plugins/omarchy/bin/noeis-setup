#!/bin/bash
# Makes Noeis the reader on this Omarchy machine, once. Each step checks
# first, so running it again changes nothing that is already in place.
#
#   - noeis-open on your PATH, and Noeis in the launcher as its own window
#     that opens EPUB, PDF and Markdown files
#   - the Noeis browser extension loaded into Omarchy's Chromium
#   - Super+Alt+N opens the panel; Super+Alt+Shift+N saves the clipboard's link
#   - "Noeis" in the Share menu (Super+Ctrl+S) saves the clipboard's link
set -euo pipefail

PLUGIN=$(cd "$(dirname "$0")/.." && pwd)
APP=${NOEIS_APP_URL:-https://www.noeis.io}
BINDINGS=$HOME/.config/hypr/bindings.lua
FLAGS=$HOME/.config/chromium-flags.conf
MENU=$HOME/.config/omarchy/extensions/omarchy-menu.jsonc
SAVE="omarchy-shell noeis saveClipboard"

done_() { printf '  %s\n' "$1"; }

mkdir -p "$HOME/.local/bin"
ln -sf "$PLUGIN/bin/noeis-open" "$HOME/.local/bin/noeis-open"
done_ "noeis-open is on your PATH"

omarchy-webapp-install Noeis "$APP" "" "noeis-open %U" \
  "application/epub+zip;application/pdf;text/markdown;" >/dev/null
done_ "Noeis is in the launcher, and opens EPUB, PDF and Markdown files"

if [[ -d $PLUGIN/extension ]] && ! grep -q "$PLUGIN/extension" "$FLAGS" 2>/dev/null; then
  if grep -q '^--load-extension=' "$FLAGS" 2>/dev/null; then
    sed -i "s|^--load-extension=.*|&,$PLUGIN/extension|" "$FLAGS"
  else
    echo "--load-extension=$PLUGIN/extension" >>"$FLAGS"
  fi
  done_ "The extension loads the next time Chromium starts (Alt+Shift+N saves the tab)"
fi

if ! grep -q 'io.noeis' "$BINDINGS"; then
  printf '\n-- Noeis\no.bind("SUPER + ALT + N", "Noeis", "omarchy-shell shell toggle io.noeis")\n' >>"$BINDINGS"
fi
if ! grep -q "$SAVE" "$BINDINGS"; then
  printf 'o.bind("SUPER + ALT + SHIFT + N", "Save link to Noeis", "%s")\n' "$SAVE" >>"$BINDINGS"
fi
done_ "Super+Alt+N opens Noeis; Super+Alt+Shift+N saves the link on your clipboard"

if ! grep -q 'trigger.share.noeis' "$MENU" 2>/dev/null; then
  mkdir -p "$(dirname "$MENU")"
  [[ -f $MENU ]] || echo '{}' >"$MENU"
  # The file is JSONC, so the entry goes in before its closing brace.
  sed -i "\$s|}\s*\$|  \"trigger.share.noeis\": {\"icon\":\"󰂺\",\"label\":\"Noeis\",\"description\":\"Save the link on your clipboard to read later\",\"action\":\"$SAVE\"},\n}|" "$MENU"
fi
done_ "Share → Noeis saves the link on your clipboard"

done_ "To give noeis.io your Omarchy colours, choose Omarchy in its theme settings once"
