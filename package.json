{
  "name": "note-taker-3-1",
  "version": "1.0.0",
  "description": "Note-taking Chrome extension with web UI and MongoDB backend",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "qa:seed": "node scripts/seed_editor_qa.js",
    "wiki:seed:qa": "node scripts/seed_wiki_qa.js",
    "weekend-readings:intake": "node scripts/preview_weekend_readings_intake.js",
    "agent:eval": "node scripts/run_agent_eval.js",
    "agent:eval:check": "node scripts/run_agent_eval.js --check",
    "agent:eval:reading": "node scripts/run_reading_eval.js",
    "judgment:evidence-harness": "node scripts/run_judgment_evidence_quality_harness.js",
    "judgment:semantic-evidence-harness": "node scripts/run_judgment_semantic_evidence_harness.js",
    "judgment:ledger-acceptance": "node scripts/run_judgment_ledger_acceptance_harness.js",
    "agent:structure-acceptance": "node scripts/run_agent_structure_acceptance.js",
    "reading:talks-back-acceptance": "node scripts/run_reading_talks_back_acceptance.js",
    "wiki:proposal-harness": "node scripts/run_wiki_proposal_quality_harness.js",
    "wiki:intelligence-harness": "node scripts/run_wiki_intelligence_harness.js",
    "wiki:intelligence-harness:judge": "node scripts/run_wiki_intelligence_harness.js --judge-live --require-judge --fixture=rich_learning_loop_page_passes_live_judge",
    "wiki:maintenance-harness": "node scripts/run_wiki_maintenance_quality_harness.js",
    "wiki:eval": "node scripts/run_page_eval.js",
    "wiki:maintenance-harness:live": "node scripts/run_wiki_maintenance_quality_harness.js --live",
    "wiki:qa": "git diff --check && node scripts/boot_check.js && npm run test:server && npm run harness:offline && cd note-taker-ui && CI=1 npm test -- --watchAll=false --runInBand src/components/wiki src/pages/PublicCasebook.test.jsx src/pages/SharedWikiPage.test.jsx src/styles/publicCasebookCss.test.js src/pages/JudgmentMirror.test.jsx && npm run build",
    "wiki:qa:live": "npm run wiki:qa && npm run wiki:intelligence-harness:judge && npm run wiki:maintenance-harness:live",
    "return-loop:verify:live": "node scripts/verify_return_loop_live.js",
    "proof:alphabet:verify": "node scripts/verify_alphabet_public_proof.js",
    "proof:alphabet:run": "node scripts/run_alphabet_filing_acceptance.js",
    "wiki:storage": "node scripts/run_wiki_storage_governor.js",
    "smoke:server": "node scripts/run_server_smoke.js",
    "smoke:imports": "node scripts/test_import_integrations_smoke.js",
    "test:server": "node scripts/test_receipt.js server",
    "harness:offline": "npm run judgment:evidence-harness && npm run judgment:semantic-evidence-harness && npm run judgment:ledger-acceptance && npm run wiki:proposal-harness && npm run wiki:intelligence-harness && npm run wiki:maintenance-harness",
    "seo:gsc": "node scripts/seo/search_console_opportunities.js",
    "extension:pack": "node scripts/pack_extension.js",
    "extension:smoke": "node scripts/extension_smoke.js",
    "chatgpt:plugin": "node scripts/validate_noeis_plugin_schema.cjs && python3 scripts/package_noeis_plugin.py",
    "test:ui": "node scripts/test_receipt.js ui",
    "test:workflow": "node --test scripts/run_server_tests.test.js scripts/ci_test_scope.test.js scripts/test_receipt.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atsokolas/note-taker-3.git"
  },
  "keywords": [],
  "author": "Athan Tsokolas",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/atsokolas/note-taker-3/issues"
  },
  "homepage": "https://github.com/atsokolas/note-taker-3#readme",
  "type": "commonjs",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@huggingface/inference": "^2.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "archiver": "^7.0.1",
    "axios": "1.20.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.24.6",
    "multer": "2.5.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.15.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
