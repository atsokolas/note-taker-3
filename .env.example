# Every variable the API reads, grouped. Blank means unset; secrets are never
# filled in here. The server runs locally with only the Core group set.

## Core
# Port the API listens on.
PORT=5500
# Interface the API binds to.
HOST=0.0.0.0
# Set to production on Render; production hides debug fixtures and requires AI_REINDEX_SECRET.
NODE_ENV=
# Signs sessions; also the fallback for the other secrets below when they are unset.
JWT_SECRET=replace_me
# The application database.
MONGODB_URI=mongodb://localhost:27017/note-taker
# Log every token check to the console.
DEBUG_AUTH=false
# Comma-separated usernames who may read all feedback and the marketing funnel. Unset means nobody.
FEEDBACK_ADMIN_USERNAMES=

## Secrets (each falls back to JWT_SECRET when unset)
# Encrypts stored integration tokens (Notion, Readwise).
INTEGRATION_SECRET=
# Signs the short-lived tokens the agent bridge hands out.
AGENT_BRIDGE_SECRET=
# Signs exported casebooks.
CASEBOOK_EXPORT_SECRET=

## Public URLs
# The web app, for links in emails.
APP_BASE_URL=https://www.noeis.io
# The web app under older names, still read for OAuth returns and the model referer.
APP_URL=
PUBLIC_APP_URL=
FRONTEND_URL=
WEB_APP_URL=
NOEIS_APP_URL=

## Deploy metadata (set by Render; reported by /api/version)
RENDER_GIT_COMMIT=
RENDER_GIT_BRANCH=
RENDER_SERVICE_NAME=
# Commit to report when not on Render.
GIT_COMMIT=

## Curated public proof pages
# Each value is a shared WikiPage id or slug. When blank, the API matches a
# shared page by title and type; production should pin every slot.
PUBLIC_PROOF_ALPHABET_PAGE=
PUBLIC_PROOF_NVIDIA_PAGE=
PUBLIC_PROOF_MARGIN_OF_SAFETY_PAGE=
PUBLIC_PROOF_CIRCLE_OF_COMPETENCE_PAGE=
PUBLIC_PROOF_MARKET_MAP_PAGE=
PUBLIC_PROOF_LIVE_QUESTION_PAGE=
PUBLIC_PROOF_NOEIS_REPO_PAGE=
PUBLIC_PROOF_OPENAI_AGENTS_JS_PAGE=
# How long shared pages and comparisons stay cached in memory.
PUBLIC_WIKI_PAGE_CACHE_TTL_MS=
PUBLIC_COMPARISON_CACHE_TTL_MS=

## AI switches
# Master switch for embeddings, indexing and model calls.
AI_ENABLED=true
# Lets the API generate drafts and summaries.
AI_GENERATION_ENABLED=false
# Required in production to call the reindex endpoint.
AI_REINDEX_SECRET=
# Batch size when reindexing vectors.
AI_UPSERT_BATCH=100

## Text generation
# Force openrouter or huggingface; by default OpenRouter is used when its key is set.
AI_TEXT_UPSTREAM=
# OpenRouter: text generation and embeddings. Without it the API has no embeddings.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_TEXT_MODEL_FALLBACKS=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=
# Attribution headers OpenRouter shows.
OPENROUTER_HTTP_REFERER=https://www.noeis.io
OPENROUTER_APP_TITLE=Noeis
# Free model the ordinary wiki builder tries first.
ORDINARY_WIKI_FREE_MODEL=
# Hugging Face router, used when OpenRouter is not.
HF_TOKEN=
HF_PROVIDER=groq
HF_TEXT_MODEL=openai/gpt-oss-120b
HF_TEXT_MODEL_FALLBACKS=openai/gpt-oss-120b:cerebras,openai/gpt-oss-120b:fireworks-ai,Qwen/Qwen3-Next-80B-A3B-Instruct:novita
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_MS=30000
# A local Ollama for brain summaries and drafts, when one runs.
OLLAMA_HOST=
OLLAMA_MODEL=
# Timeout for the model behind wiki Ask.
WIKI_ASK_MODEL_TIMEOUT_MS=

## Model routes per agent task (comma-separated model:provider lists)
# All routes at once as JSON, or one variable per task; unset uses built-in defaults.
OPENROUTER_AGENT_MODEL_ROUTES_JSON=
OPENROUTER_AGENT_CHAT_ROUTES=
OPENROUTER_AGENT_TOOL_ROUTES=
OPENROUTER_AGENT_STRUCTURE_ROUTES=
OPENROUTER_AGENT_ARTIFACT_ROUTES=
OPENROUTER_AGENT_CRITIQUE_ROUTES=
OPENROUTER_AGENT_HYGIENE_ROUTES=
OPENROUTER_AGENT_DEEP_AUDIT_ROUTES=
HF_AGENT_MODEL_ROUTES_JSON=
HF_AGENT_CHAT_ROUTES=openai/gpt-oss-120b:groq,openai/gpt-oss-120b:cerebras,openai/gpt-oss-120b:fireworks-ai,Qwen/Qwen3-Next-80B-A3B-Instruct:novita
HF_AGENT_TOOL_ROUTES=openai/gpt-oss-120b:groq,openai/gpt-oss-120b:cerebras,openai/gpt-oss-120b:fireworks-ai,Qwen/Qwen3-Coder-Next:novita
HF_AGENT_STRUCTURE_ROUTES=openai/gpt-oss-120b:groq,openai/gpt-oss-120b:cerebras,openai/gpt-oss-120b:fireworks-ai,google/gemma-4-26B-A4B-it:novita
HF_AGENT_ARTIFACT_ROUTES=
HF_AGENT_CRITIQUE_ROUTES=
HF_AGENT_HYGIENE_ROUTES=
HF_AGENT_DEEP_AUDIT_ROUTES=Qwen/Qwen3-Next-80B-A3B-Thinking:novita,deepseek-ai/DeepSeek-V4-Pro:together,openai/gpt-oss-120b:groq

## Embeddings
# The default model matches the 384-dimension vectors stored in Atlas; changing
# it means re-embedding everything and rebuilding the vector index.
OPENROUTER_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
OPENROUTER_EMBEDDING_TIMEOUT_MS=
# The embedding job queue: off switches, cadence, batch, attempts, stale jobs, rate-limit stop, backoff.
EMBEDDING_JOB_WORKER_DISABLED=false
EMBEDDING_PERSISTENT_QUEUE_DISABLED=false
EMBEDDING_JOB_WORKER_INTERVAL_MS=60000
EMBEDDING_JOB_WORKER_BATCH_SIZE=5
EMBEDDING_JOB_MAX_ATTEMPTS=20
EMBEDDING_JOB_STALE_AFTER_MS=900000
EMBEDDING_JOB_RATE_LIMIT_BREAK=3
EMBEDDING_RETRY_BASE_MS=60000
EMBEDDING_RETRY_MAX_MS=3600000

## Reading loop
# Raw cosine band for a passage to count as related (see server/ai/vectorStore.js).
READING_LOOP_SIMILARITY_MIN=0.45
READING_LOOP_SIMILARITY_MAX=0.90
# Most reading-loop runs per reader per day.
READING_LOOP_DAILY_RUN_CAP=

## AI service (ai_service/, Python): synthesis
# Where the API reaches it, the secret both sides hold, and how the API calls it.
AI_SERVICE_URL=
AI_SHARED_SECRET=
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_RETRIES=1
AI_SERVICE_MAX_CONCURRENT=
# Limits on what the API sends to synthesis, and how long it waits.
AI_SYNTH_UPSTREAM_TIMEOUT_MS=12000
AI_SYNTH_UPSTREAM_RETRIES=0
AI_SYNTH_MAX_ITEMS=60
AI_SYNTH_MAX_CHARS=25000
AI_SYNTH_MAX_ITEM_CHARS=1200
# Read by ai_service itself.
HF_MODELS_BASE_URL=https://router.huggingface.co/hf-inference/models
AI_SYNTH_MAX_OUTPUT_ITEM_CHARS=220
AI_SYNTH_MAX_ATTEMPTS=1
AI_SYNTH_MAX_LATENCY_MS=12000
AI_SYNTH_MAX_TOKENS=260

## Imports and connections (OAuth apps)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
READWISE_CLIENT_ID=
READWISE_CLIENT_SECRET=
READWISE_REDIRECT_URI=
# How the Readwise token request authenticates.
READWISE_TOKEN_AUTH_METHOD=none

## ChatGPT app and hosted MCP
# The OAuth issuer URL; unset turns the ChatGPT connection off.
NOEIS_CHATGPT_OAUTH_ISSUER=
# MCP resource URL; defaults to <issuer>/mcp.
NOEIS_CHATGPT_MCP_RESOURCE=
# JSON array of registered OAuth clients.
NOEIS_CHATGPT_OAUTH_CLIENTS=[]
# Where the MCP server calls the API; defaults to this process.
NOEIS_MCP_INTERNAL_API_URL=
# Answer MCP requests as JSON instead of event streams.
NOEIS_MCP_JSON_RESPONSES=false

## Wiki workers
# New-source events: off switch, cadence, batch, per-reader limit, stale lease.
WIKI_SOURCE_EVENT_WORKER_DISABLED=false
WIKI_SOURCE_EVENT_WORKER_INTERVAL_MS=60000
WIKI_SOURCE_EVENT_WORKER_BATCH_SIZE=10
WIKI_SOURCE_EVENT_WORKER_PER_USER=3
WIKI_SOURCE_EVENT_LEASE_STALE_AFTER_MS=1800000
# Scheduled page refresh: off switch, run at boot, cadence, batch, page age.
WIKI_SCHEDULED_MAINTENANCE_DISABLED=false
WIKI_SCHEDULED_MAINTENANCE_RUN_ON_START=false
WIKI_SCHEDULED_MAINTENANCE_INTERVAL_MS=21600000
WIKI_SCHEDULED_MAINTENANCE_BATCH_SIZE=3
WIKI_SCHEDULED_MAINTENANCE_MAX_AGE_MS=86400000
# Daily storage cleanup: off switch, run at boot.
WIKI_STORAGE_GOVERNOR_DISABLED=false
WIKI_STORAGE_GOVERNOR_RUN_ON_START=true
# Read by scripts/run_wiki_storage_governor.js (npm run wiki:storage).
WIKI_STORAGE_RETENTION_DAYS=45
WIKI_STORAGE_PRESSURE_RETENTION_DAYS=14
WIKI_STORAGE_HIGH_WATER_BYTES=440401920
WIKI_STORAGE_GOVERNOR_BATCH_SIZE=2500
WIKI_STORAGE_REVISION_PAGE_LIMIT=10

## Watchers (each: off switch, run at boot, cadence, batch, how stale a check may be)
# Reading feeds.
READING_WATCH_WORKER_DISABLED=false
READING_WATCH_RUN_ON_START=false
READING_WATCH_WORKER_INTERVAL_MS=21600000
READING_WATCH_WORKER_BATCH_SIZE=10
READING_WATCH_MAX_AGE_MS=21600000
# SEC EDGAR filings, and the User-Agent the SEC requires (EDGAR_USER_AGENT is the older name).
EDGAR_WATCH_WORKER_DISABLED=false
EDGAR_WATCH_RUN_ON_START=false
EDGAR_WATCH_WORKER_INTERVAL_MS=21600000
EDGAR_WATCH_WORKER_BATCH_SIZE=10
EDGAR_WATCH_MAX_AGE_MS=21600000
SEC_USER_AGENT=
EDGAR_USER_AGENT=
# Earnings transcripts: paid data, off unless PAID_DATA_SOURCES_ENABLED=true with an FMP key
# (FINANCIAL_MODELING_PREP_API_KEY is the older name); optionally log when the key is missing.
PAID_DATA_SOURCES_ENABLED=false
FMP_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
TRANSCRIPT_WATCH_WORKER_DISABLED=false
TRANSCRIPT_WATCH_RUN_ON_START=false
TRANSCRIPT_WATCH_WORKER_INTERVAL_MS=86400000
TRANSCRIPT_WATCH_WORKER_BATCH_SIZE=5
TRANSCRIPT_WATCH_MAX_AGE_MS=86400000
TRANSCRIPT_WATCH_LOG_MISSING_KEY=false
# GitHub repositories, and a token for higher rate limits (GITHUB_PUBLIC_REPO_TOKEN is the older name).
GITHUB_REPO_WATCH_WORKER_DISABLED=false
GITHUB_REPO_WATCH_RUN_ON_START=true
GITHUB_REPO_WATCH_WORKER_INTERVAL_MS=21600000
GITHUB_REPO_WATCH_WORKER_BATCH_SIZE=5
GITHUB_REPO_WATCH_MAX_AGE_MS=21600000
GITHUB_TOKEN=
GITHUB_PUBLIC_REPO_TOKEN=

## Readwise on a timer: new highlights arrive without pressing Sync.
## Does nothing for readers without a Readwise connection.
READWISE_SYNC_WORKER_DISABLED=false
READWISE_SYNC_WORKER_INTERVAL_MS=1800000
READWISE_SYNC_MAX_AGE_MS=14400000

## Morning Paper email (off unless EMAIL_DISABLED=false)
EMAIL_DISABLED=true
RESEND_API_KEY=
MORNING_PAPER_FROM_EMAIL=
MORNING_PAPER_UNSUBSCRIBE_SECRET=
# The API base used in unsubscribe links.
EMAIL_PUBLIC_API_BASE_URL=https://note-taker-3-unrg.onrender.com
# Delivery worker: off switch, run at boot, cadence, batch; and how old a cached paper may be.
MORNING_PAPER_EMAIL_WORKER_DISABLED=false
MORNING_PAPER_EMAIL_RUN_ON_START=false
MORNING_PAPER_EMAIL_WORKER_INTERVAL_MS=900000
MORNING_PAPER_EMAIL_BATCH_SIZE=50
WIKI_BRIEFING_CACHE_MAX_AGE_MS=21600000

## Product analytics (ids and kinds only, never what a reader wrote)
ANALYTICS_ENABLED=true
# Local JSON-lines log of events.
ANALYTICS_LOG_PATH=server/logs/product-events.jsonl
# Salt for hashed user ids; falls back to JWT_SECRET.
ANALYTICS_HASH_SALT=
# Also send events to PostHog when host and key are both set.
POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
POSTHOG_TIMEOUT_MS=3000

## Scripts and checks
# A throwaway database for npm run agent:eval; unset starts one in memory.
AGENT_EVAL_MONGODB_URI=
# npm run agent:approval-smoke against a deployed API.
AGENT_APPROVAL_SMOKE_BASE_URL=http://127.0.0.1:5001
AGENT_APPROVAL_SMOKE_TOKEN=
AGENT_APPROVAL_SMOKE_ACTION=reject
AGENT_APPROVAL_SMOKE_OUTPUT_DIR=tmp/agent-approval-smoke-runs
